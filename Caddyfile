{$DOMAIN:localhost} {
    # 后端 API —— 直接转给 FastAPI, 不经 Next.js
    handle /api/backend/* {
        uri strip_prefix /api/backend
        reverse_proxy backend:8000
    }

    # 其余所有请求 → Next.js
    handle {
        reverse_proxy web:3000
    }

    encode gzip

    log {
        output stdout
        format console
    }
}
