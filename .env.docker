# ===== 复制为 .env 后修改 =====
# cp .env.docker .env && docker compose -f docker-compose.prod.yml up -d

# 你的域名 (Caddy 自动申请 HTTPS 证书)
DOMAIN=your-domain.example.com

# 邀请码 (注册时需要输入, 留空=不启用)
WARDROBE_ACCESS_CODE=

# 管理后台密码 (留空=禁用管理后台)
WARDROBE_ADMIN_CODE=

# Session cookie 签名密钥 (务必改成随机值! openssl rand -hex 32)
WARDROBE_SESSION_SECRET=change-me-please-run-openssl-rand-hex-32

# SenseNova VLM API Key (https://token.sensenova.cn 获取)
WARDROBE_AI_SENSENOVA_API_KEY=your-sensenova-api-key

# SenseNova 模型 (一般不需要改)
WARDROBE_AI_SENSENOVA_MODEL=sensenova-6.7-flash-lite
